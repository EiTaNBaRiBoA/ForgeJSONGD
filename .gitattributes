# Normalize line endings for all files that Git considers text files.
* text=auto eol=lf

# Only include the addons folder when downloading a zip (GitHub or the Asset Library).
# The license travels inside addons/ForgeJSONGD/, so several addons can be installed without clashing at the project root.
/**        export-ignore
/addons    !export-ignore
/addons/** !export-ignore
